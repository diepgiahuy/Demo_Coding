    frame.append(cube("Window_Frame_R", (x0 + 1.05, y0, z0 + 1.1), (.12, .16, 2.3), steel, collection, .02))
    frame.append(cube("Window_Frame_T", (x0, y0, z0 + 2.2), (2.2, .16, .12), steel, collection, .02))
    frame.append(cube("Window_Frame_B", (x0, y0, z0), (2.2, .16, .12), steel, collection, .02))
    for f in frame:
        if physics:
            add_rigidbody(f, "PASSIVE", shape="BOX", friction=.5)
    shards = []
    cols, rows = 4, 4
    left, right = x0 - .96, x0 + .96
    bottom, top = z0 + .10, z0 + 2.10
    dx, dz = (right - left) / cols, (top - bottom) / rows
    for r in range(rows):
        for c in range(cols):
            xa, xb = left + c * dx, left + (c + 1) * dx
            za, zb = bottom + r * dz, bottom + (r + 1) * dz
            jx = (random.random() - .5) * dx * .16
            jz = (random.random() - .5) * dz * .16
            center = ((xa + xb) * .5 + jx, y0, (za + zb) * .5 + jz)
            if (r + c) % 2 == 0:
                tris = [
                    [(xa, y0, za), (xb, y0, za), (center[0], y0, center[2])],
                    [(xb, y0, za), (xb, y0, zb), (center[0], y0, center[2])],
                    [(xb, y0, zb), (xa, y0, zb), (center[0], y0, center[2])],
                    [(xa, y0, zb), (xa, y0, za), (center[0], y0, center[2])],
                ]
            else:
                tris = [
