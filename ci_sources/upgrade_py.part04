        cube("Barricade_Foot_R", (x+.75, y, z+.08), (.65, .42, .12), dark, collection, .03),
    ]
    posts = [
        cube("Barricade_Post_L", (x-.75, y, z+.72), (.12, .12, 1.25), white, collection, .02),
        cube("Barricade_Post_R", (x+.75, y, z+.72), (.12, .12, 1.25), white, collection, .02),
    ]
    board = cube("Barricade_Board", (x, y, z+1.03), (1.75, .14, .30), orange, collection, .025)
    for f in feet:
        add_rigidbody(f, "PASSIVE", shape="BOX", friction=.95)
    for p in posts:
        add_rigidbody(p, "ACTIVE", mass=2.2, shape="BOX", friction=.75, start_deactivated=True)
    add_rigidbody(board, "ACTIVE", mass=4.2, shape="BOX", friction=.65, start_deactivated=True)
    cons = []
    for p, f in zip(posts, feet):
        cons.append(add_constraint("Barricade_PostJoint", p.location, f, p, collection,
                                   "FIXED", True, 9.0))
    cons.append(add_constraint("Barricade_BoardJoint_L", (x-.70, y, z+1.03), posts[0], board,
                               collection, "FIXED", True, 7.0))
    cons.append(add_constraint("Barricade_BoardJoint_R", (x+.70, y, z+1.03), posts[1], board,
                               collection, "FIXED", True, 7.0))
    return feet + posts + [board], cons


def camera_look_at(scene, loc, target, lens=50):
    data = bpy.data.cameras.new("Camera_Physics")
    cam = bpy.data.objects.new("Camera_Physics", data)
    scene.collection.objects.link(cam)
    cam.location = loc
    cam.rotation_euler = (Vector(target) - cam.location).to_track_quat("-Z", "Y").to_euler()
    data.lens = lens
    data.sensor_width = 36
    scene.camera = cam
    return cam


def add_light(scene, name, kind, loc, energy, size=5.0, rotation=None):
    data = bpy.data.lights.new(name, kind)
    data.energy = energy
    if kind == "AREA":
        data.shape = "DISK"
        data.size = size
    obj = bpy.data.objects.new(name, data)
    scene.collection.objects.link(obj)
    obj.location = loc
    if rotation:
        obj.rotation_euler = rotation
    return obj


def build_demo():
    bpy.ops.wm.open_mainfile(filepath=str(V2_LIBRARY))
    bpy.ops.scene.new(type="EMPTY")
    scene = bpy.context.scene
    scene.name = "02_FX_PHYSICS_DEMO"
    scene.unit_settings.system = "METRIC"
    scene.render.engine = "BLENDER_EEVEE"
    scene.render.resolution_x = 640
    scene.render.resolution_y = 360
    scene.render.resolution_percentage = 100
    scene.render.fps = 24
    scene.frame_start = 1
    scene.frame_end = 84
    scene.render.image_settings.file_format = "FFMPEG"
    scene.render.ffmpeg.format = "MPEG4"
    scene.render.ffmpeg.codec = "H264"
    scene.render.ffmpeg.constant_rate_factor = "MEDIUM"
    scene.render.filepath = str(DEMO_MP4)
    try:
        scene.view_settings.look = "AgX - Medium High Contrast"
    except Exception:
        pass
    scene.world.color = (.035, .045, .06)

    demo = bpy.data.collections.new("FX_PHYSICS_DEMO_CONTENT")
    scene.collection.children.link(demo)
    ground_mat = make_material("demo_asphalt_v2", (.055, .065, .073), .82)
    wall_mat = make_material("demo_wall_v2", (.34, .30, .26), .72)
    line_mat = make_material("demo_line_v2", (.82, .72, .26), .65)
    ground = cube("Physics_Ground", (0, 0, -.12), (12, 18, .24), ground_mat, demo)
    add_rigidbody(ground, "PASSIVE", shape="BOX", friction=.95)
    # Road markings improve motion readability.
    for x in (-.09, .09):
        cube("Road_Line", (x, -1.5, .012), (.055, 11.0, .018), line_mat, demo)

    # Background storefronts from the actual kit.
    add_collection_instance("SHOP_Pharmacy", demo, (-3.1, 4.8, 0), 0.0, .72)
    add_collection_instance("SHOP_Convenience", demo, (3.1, 4.8, 0), 0.0, .72)

    # Breakable barricade and loose cones.
    barricade, break_cons = make_breakable_barricade(demo, (0, -1.0, 0))
    orange = bpy.data.materials["safety_orange_v2"]
    cones = []
    for i, x in enumerate((-1.3, 1.3)):
        c = cube("ConeProxy_%d" % i, (x, -1.15, .34), (.36, .36, .68), orange, demo, .04)
        add_rigidbody(c, "ACTIVE", mass=.65, shape="BOX", friction=.9, restitution=.08, start_deactivated=True)
        cones.append(c)

    # Character ragdoll stands slightly behind the barrier.
    rag_proxies, rag_constraints = copy_character_as_ragdoll(
        "CHR_Civilian_Green", demo, (.55, -.05, 0), 0.0
    )

    # Animated passive collision proxy drives the real sedan collection instance.
    car_proxy = cube("CrashCar_Collider", (0, -7.3, .65), (1.75, 3.9, 1.20), None, demo)
    add_rigidbody(car_proxy, "PASSIVE", shape="BOX", friction=.85, restitution=.02)
    car_proxy.hide_render = True
    car_vis = add_collection_instance("VEH_Sedan", demo, (0, 0, 0), 0.0, .92, "CrashCar_Visual")
    car_vis.parent = car_proxy
    car_vis.location = (0, 0, -.02)
    car_proxy.location = (0, -7.3, .65)
    car_proxy.keyframe_insert("location", frame=1)
    car_proxy.location = (0, 1.4, .65)
    car_proxy.keyframe_insert("location", frame=42)
    car_proxy.location = (0, 2.6, .65)
    car_proxy.keyframe_insert("location", frame=56)
    if car_proxy.animation_data and car_proxy.animation_data.action:
        for fc in car_proxy.animation_data.action.fcurves:
            for kp in fc.keyframe_points:
                kp.interpolation = "LINEAR"

    # Physics window on the right wall.
