    obj = bpy.data.objects.new(name or ("INST_" + source_name), None)
    collection.objects.link(obj)
    obj.instance_type = "COLLECTION"
    obj.instance_collection = src
    obj.location = loc
    obj.rotation_euler.z = rot
    obj.scale = (scale, scale, scale)
    return obj


def copy_character_as_ragdoll(source_name, target_collection, location, rotation=0.0):
    src = bpy.data.collections.get(source_name)
    if src is None:
        raise KeyError(source_name)
    copies = {}
    for old in src.all_objects:
        new = old.copy()
        if old.data and hasattr(old.data, "copy") and old.type == "ARMATURE":
            new.data = old.data.copy()
        target_collection.objects.link(new)
        copies[old] = new
    for old, new in copies.items():
        if old.parent in copies:
            new.parent = copies[old.parent]
            new.parent_type = old.parent_type
            new.parent_bone = old.parent_bone
            new.matrix_parent_inverse = old.matrix_parent_inverse.copy()
    rig = next((o for o in copies.values() if o.type == "ARMATURE"), None)
    if rig is None:
        raise RuntimeError(source_name + " has no armature")
    rig.matrix_world = Matrix.Translation(Vector(location)) @ Matrix.Rotation(rotation, 4, "Z")
    bpy.context.view_layer.update()

    bone_cfg = {
        "pelvis": (.17, 5.5), "spine": (.16, 4.0), "chest": (.20, 6.0), "head": (.15, 4.5),
        "upper_arm.L": (.075, 1.8), "upper_arm.R": (.075, 1.8),
        "forearm.L": (.065, 1.3), "forearm.R": (.065, 1.3),
        "hand.L": (.065, .5), "hand.R": (.065, .5),
        "thigh.L": (.10, 4.0), "thigh.R": (.10, 4.0),
        "shin.L": (.085, 2.8), "shin.R": (.085, 2.8),
        "foot.L": (.09, .8), "foot.R": (.09, .8),
    }
    proxies = {}
    for bone_name, (radius, mass) in bone_cfg.items():
        pb = rig.pose.bones.get(bone_name)
        if pb is None:
            continue
        head = rig.matrix_world @ pb.head
        tail = rig.matrix_world @ pb.tail
        vec = tail - head
        length = max(vec.length, radius * 2.2)
        mid = (head + tail) * .5
        p = cube("RAG_" + bone_name, mid, (radius * 2, radius * 2, length), None, target_collection)
        p.rotation_mode = "QUATERNION"
        p.rotation_quaternion = vec.to_track_quat("Z", "Y")
        bpy.context.view_layer.update()
        add_rigidbody(p, "ACTIVE", mass=mass, shape="BOX", friction=.8,
                      restitution=.02, start_deactivated=True, margin=.006)
        p.hide_render = True
        p.display_type = "WIRE"
        proxies[bone_name] = p

    bpy.context.view_layer.update()
    # Reparent all visible bone parts to the matching rigid proxy.
    for obj in list(copies.values()):
        if obj == rig or obj.type != "MESH":
            continue
        if obj.parent == rig and obj.parent_type == "BONE" and obj.parent_bone in proxies:
            world = obj.matrix_world.copy()
            obj.parent = proxies[obj.parent_bone]
            obj.parent_type = "OBJECT"
            obj.parent_bone = ""
            obj.matrix_world = world
    rig.hide_render = True
    rig.hide_viewport = True

    parent_map = {
        "spine": "pelvis", "chest": "spine", "head": "chest",
        "upper_arm.L": "chest", "upper_arm.R": "chest",
        "forearm.L": "upper_arm.L", "forearm.R": "upper_arm.R",
        "hand.L": "forearm.L", "hand.R": "forearm.R",
        "thigh.L": "pelvis", "thigh.R": "pelvis",
        "shin.L": "thigh.L", "shin.R": "thigh.R",
        "foot.L": "shin.L", "foot.R": "shin.R",
    }
    limits = {
        "spine": ((-.25, .30), (-.18, .18), (-.18, .18)),
        "chest": ((-.28, .35), (-.22, .22), (-.22, .22)),
        "head": ((-.55, .45), (-.40, .40), (-.55, .55)),
        "upper_arm.L": ((-1.4, 1.1), (-.9, .9), (-1.2, 1.2)),
        "upper_arm.R": ((-1.4, 1.1), (-.9, .9), (-1.2, 1.2)),
        "forearm.L": ((-1.9, .15), (-.2, .2), (-.35, .35)),
        "forearm.R": ((-1.9, .15), (-.2, .2), (-.35, .35)),
        "hand.L": ((-.65, .65), (-.45, .45), (-.45, .45)),
        "hand.R": ((-.65, .65), (-.45, .45), (-.45, .45)),
        "thigh.L": ((-1.1, .8), (-.55, .55), (-.45, .45)),
        "thigh.R": ((-1.1, .8), (-.55, .55), (-.45, .45)),
        "shin.L": ((-.1, 2.1), (-.12, .12), (-.12, .12)),
        "shin.R": ((-.1, 2.1), (-.12, .12), (-.12, .12)),
        "foot.L": ((-.55, .55), (-.2, .2), (-.25, .25)),
        "foot.R": ((-.55, .55), (-.2, .2), (-.25, .25)),
    }
    constraints = []
    for child_name, parent_name in parent_map.items():
        if child_name not in proxies or parent_name not in proxies:
            continue
        pb = rig.pose.bones.get(child_name)
        loc = rig.matrix_world @ pb.head
        constraints.append(add_constraint(
            "RAG_JOINT_" + child_name, loc, proxies[parent_name], proxies[child_name],
            target_collection, "GENERIC", False, angular_limits=limits.get(child_name)
        ))
    return proxies, constraints


def make_breakable_barricade(collection, loc=(0, 0, 0)):
    orange = make_material("safety_orange_v2", (.95, .21, .025), .64)
    white = make_material("safety_white_v2", (.82, .83, .78), .68)
    dark = make_material("rubber_v2", (.025, .03, .035), .85)
    x, y, z = loc
    feet = [
        cube("Barricade_Foot_L", (x-.75, y, z+.08), (.65, .42, .12), dark, collection, .03),
